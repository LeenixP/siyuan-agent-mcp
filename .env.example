# SiYuan API base URL (default: http://127.0.0.1:6806)
SIYUAN_API_URL=http://127.0.0.1:6806

# SiYuan API token — find it in SiYuan under: Settings → About → API token
SIYUAN_API_TOKEN=your-api-token-here

# HTTP timeout in milliseconds
SIYUAN_TIMEOUT_MS=30000

# When enabled, only read-only tools are exposed
SIYUAN_READ_ONLY=false

# When enabled, deprecated pre-v3 tool names such as read_doc are also registered
SIYUAN_ENABLE_LEGACY_ALIASES=false

# When disabled, the raw SQL escape hatch is not registered
SIYUAN_ENABLE_SQL=true
